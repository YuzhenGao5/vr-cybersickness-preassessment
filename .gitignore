# Python environments and caches
.venv/
.venv-normal-hmd/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Credentials and machine-local settings
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# Raw and processed participant data. Only the small synthetic parser fixtures
# are public source artifacts.
data/**
!data/.gitkeep
!data/cyre_status.md
!data/test_scenes/
!data/test_scenes/**
features/**

# Experiment outputs may contain participant/session identifiers, absolute
# paths, download URLs or credentials copied from third-party pages. Public,
# aggregate release evidence is maintained separately in release/.
results/**
!results/.gitkeep
!results/unity_semantic_fixture/
!results/unity_semantic_fixture/**
audit/**
figures/**
tmp/**

# Generated model binaries and research checkpoints. The two explicitly
# unignored JSON files are the reviewed runtime metadata/export used by the
# public source demo.
models/**
!models/normal_hmd_v4_metadata.json
!models/unity_decision_brain_v0_unity.json
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
*.pickle
*.parquet
*.onnx

